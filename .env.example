# ApplyPilot AI - Local Environment Configuration
# Copy this file to .env and customize values before running in production.

# --- Application ---
APP_NAME=ApplyPilot AI
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate a strong random secret for production, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-this-secret-key-before-any-shared-deployment
# Optional dedicated key for encrypting extracted resume text at rest (falls back to SECRET_KEY)
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS & Frontend ---
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database ---
# Local MVP default (SQLite). Switch to postgresql+psycopg://user:pass@host:5432/applypilot for production.
DATABASE_URL=sqlite:///./data/applypilot.db

# --- Local Storage ---
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
SCREENSHOT_DIR=./data/screenshots
MAX_UPLOAD_MB=10

# --- Local AI (Ollama - Non-Negotiable No Paid Cloud APIs) ---
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_FALLBACK_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_TEMPERATURE=0.1

# --- Browser Automation (Playwright) ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MAX_CONCURRENT_CONTEXTS=2
PLAYWRIGHT_TIMEOUT_MS=20000
# Security guard: keep false in production so untrusted URLs cannot target localhost/private networks.
# Set true ONLY during controlled local test-site execution when explicitly authorized.
ALLOW_LOCALHOST_AUTOMATION=false

